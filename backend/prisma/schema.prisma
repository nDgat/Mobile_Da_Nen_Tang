generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum SeatType {
  STANDARD
  VIP
}

enum ShowtimeStatus {
  SCHEDULED
  CANCELLED
  FINISHED
}

enum SeatStatus {
  AVAILABLE
  HELD
  BOOKED
}

enum BookingStatus {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum ConcessionCategory {
  POPCORN
  DRINK
  COMBO
}

enum VoucherDiscountType {
  FIXED
  PERCENTAGE
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
  CANCELLED
}

enum NotificationType {
  BOOKING_CONFIRMED
  SHOWTIME_REMINDER
  SYSTEM
}

model User {
  id            Int             @id @default(autoincrement())
  email         String          @unique @db.VarChar(191)
  passwordHash  String          @db.VarChar(255)
  fullName      String          @db.VarChar(100)
  role          UserRole        @default(CUSTOMER)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now()) @db.DateTime(3)
  updatedAt     DateTime        @updatedAt @db.DateTime(3)
  bookings      Booking[]
  refreshTokens RefreshToken[]
  notifications Notification[]
  reviews       MovieReview[]
  favorites     MovieFavorite[]
  auditLogs     AuditLog[]
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   String   @db.VarChar(100)
  beforeData Json?
  afterData  Json?
  requestId  String?  @db.VarChar(100)
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(255)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime  @db.DateTime(3)
  revokedAt DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Movie {
  id              Int             @id @default(autoincrement())
  title           String          @db.VarChar(255)
  synopsis        String?         @db.Text
  durationMinutes Int
  releaseDate     DateTime        @db.Date
  posterUrl       String?         @db.VarChar(2048)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now()) @db.DateTime(3)
  updatedAt       DateTime        @updatedAt @db.DateTime(3)
  showtimes       Showtime[]
  reviews         MovieReview[]
  favorites       MovieFavorite[]

  @@index([releaseDate])
}

model Cinema {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(150)
  address  String  @db.VarChar(255)
  city     String  @db.VarChar(100)
  isActive Boolean @default(true)
  rooms    Room[]

  @@index([city])
}

model Room {
  id        Int        @id @default(autoincrement())
  cinemaId  Int
  name      String     @db.VarChar(100)
  isActive  Boolean    @default(true)
  cinema    Cinema     @relation(fields: [cinemaId], references: [id], onDelete: Restrict)
  seats     Seat[]
  showtimes Showtime[]

  @@unique([cinemaId, name])
}

model Seat {
  id            Int            @id @default(autoincrement())
  roomId        Int
  rowLabel      String         @db.VarChar(5)
  seatNumber    Int
  type          SeatType       @default(STANDARD)
  isActive      Boolean        @default(true)
  room          Room           @relation(fields: [roomId], references: [id], onDelete: Restrict)
  showtimeSeats ShowtimeSeat[]

  @@unique([roomId, rowLabel, seatNumber])
}

model Showtime {
  id       Int            @id @default(autoincrement())
  movieId  Int
  roomId   Int
  startsAt DateTime       @db.DateTime(3)
  endsAt   DateTime       @db.DateTime(3)
  status   ShowtimeStatus @default(SCHEDULED)
  movie    Movie          @relation(fields: [movieId], references: [id], onDelete: Restrict)
  room     Room           @relation(fields: [roomId], references: [id], onDelete: Restrict)
  seats    ShowtimeSeat[]
  bookings Booking[]

  @@unique([roomId, startsAt])
  @@index([movieId, startsAt])
}

// Một dòng duy nhất cho mỗi ghế trong mỗi suất; đây là trạng thái sở hữu hiện tại.
model ShowtimeSeat {
  id               Int           @id @default(autoincrement())
  showtimeId       Int
  seatId           Int
  price            Decimal       @db.Decimal(12, 0)
  status           SeatStatus    @default(AVAILABLE)
  currentBookingId Int?
  holdExpiresAt    DateTime?     @db.DateTime(3)
  showtime         Showtime      @relation(fields: [showtimeId], references: [id], onDelete: Restrict)
  seat             Seat          @relation(fields: [seatId], references: [id], onDelete: Restrict)
  currentBooking   Booking?      @relation("CurrentSeats", fields: [currentBookingId], references: [id], onDelete: Restrict)
  bookingHistory   BookingSeat[]

  @@unique([showtimeId, seatId])
  @@index([status, holdExpiresAt])
  @@index([currentBookingId])
}

model Booking {
  id                 Int                     @id @default(autoincrement())
  code               String                  @unique @default(uuid()) @db.VarChar(36)
  userId             Int
  showtimeId         Int
  status             BookingStatus           @default(PENDING)
  seatSubtotal       Decimal                 @default(0) @db.Decimal(12, 0)
  serviceFee         Decimal                 @default(0) @db.Decimal(12, 0)
  concessionSubtotal Decimal                 @default(0) @db.Decimal(12, 0)
  discountAmount     Decimal                 @default(0) @db.Decimal(12, 0)
  totalAmount        Decimal                 @db.Decimal(12, 0)
  expiresAt          DateTime                @db.DateTime(3)
  confirmedAt        DateTime?               @db.DateTime(3)
  createdAt          DateTime                @default(now()) @db.DateTime(3)
  updatedAt          DateTime                @updatedAt @db.DateTime(3)
  user               User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  showtime           Showtime                @relation(fields: [showtimeId], references: [id], onDelete: Restrict)
  seats              BookingSeat[]
  currentSeats       ShowtimeSeat[]          @relation("CurrentSeats")
  concessions        BookingConcessionItem[]
  voucherId          Int?
  voucherCode        String?                 @db.VarChar(50)
  voucher            Voucher?                @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  payments           Payment[]
  notifications      Notification[]

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([voucherId])
}

model Payment {
  id            Int           @id @default(autoincrement())
  code          String        @unique @default(uuid()) @db.VarChar(36)
  bookingId     Int
  provider      String        @default("MOCK") @db.VarChar(30)
  amount        Decimal       @db.Decimal(12, 0)
  status        PaymentStatus
  failureReason String?       @db.VarChar(255)
  completedAt   DateTime      @default(now()) @db.DateTime(3)
  createdAt     DateTime      @default(now()) @db.DateTime(3)
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  bookingId Int?
  type      NotificationType
  title     String           @db.VarChar(150)
  body      String           @db.VarChar(500)
  isRead    Boolean          @default(false)
  readAt    DateTime?        @db.DateTime(3)
  createdAt DateTime         @default(now()) @db.DateTime(3)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking   Booking?         @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([bookingId])
}

model MovieReview {
  id        Int      @id @default(autoincrement())
  userId    Int
  movieId   Int
  rating    Int
  comment   String?  @db.VarChar(1000)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([movieId, isVisible, createdAt])
}

model MovieFavorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  movieId   Int
  createdAt DateTime @default(now()) @db.DateTime(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([userId, createdAt])
  @@index([movieId])
}

model Voucher {
  id                Int                 @id @default(autoincrement())
  code              String              @unique @db.VarChar(50)
  name              String              @db.VarChar(150)
  description       String?             @db.VarChar(500)
  discountType      VoucherDiscountType
  discountValue     Decimal             @db.Decimal(12, 0)
  minOrderAmount    Decimal             @default(0) @db.Decimal(12, 0)
  maxDiscountAmount Decimal?            @db.Decimal(12, 0)
  startsAt          DateTime            @db.DateTime(3)
  endsAt            DateTime            @db.DateTime(3)
  usageLimit        Int?
  usedCount         Int                 @default(0)
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now()) @db.DateTime(3)
  updatedAt         DateTime            @updatedAt @db.DateTime(3)
  bookings          Booking[]

  @@index([isActive, startsAt, endsAt])
}

model ConcessionProduct {
  id           Int                     @id @default(autoincrement())
  name         String                  @db.VarChar(150)
  description  String?                 @db.VarChar(500)
  category     ConcessionCategory
  price        Decimal                 @db.Decimal(12, 0)
  imageUrl     String?                 @db.VarChar(2048)
  isActive     Boolean                 @default(true)
  sortOrder    Int                     @default(0)
  createdAt    DateTime                @default(now()) @db.DateTime(3)
  updatedAt    DateTime                @updatedAt @db.DateTime(3)
  bookingItems BookingConcessionItem[]

  @@index([isActive, sortOrder])
}

model BookingConcessionItem {
  id          Int               @id @default(autoincrement())
  bookingId   Int
  productId   Int
  productName String            @db.VarChar(150)
  unitPrice   Decimal           @db.Decimal(12, 0)
  quantity    Int
  lineTotal   Decimal           @db.Decimal(12, 0)
  booking     Booking           @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  product     ConcessionProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([bookingId, productId])
  @@index([productId])
}

// Lịch sử dòng vé vẫn còn khi đơn hết hạn/hủy và ghế được bán cho đơn mới.
model BookingSeat {
  id             Int          @id @default(autoincrement())
  bookingId      Int
  showtimeSeatId Int
  unitPrice      Decimal      @db.Decimal(12, 0)
  seatLabel      String       @db.VarChar(20)
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  showtimeSeat   ShowtimeSeat @relation(fields: [showtimeSeatId], references: [id], onDelete: Restrict)

  @@unique([bookingId, showtimeSeatId])
}
