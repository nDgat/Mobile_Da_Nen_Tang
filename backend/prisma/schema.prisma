generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum SeatType {
  STANDARD
  VIP
}

enum ShowtimeStatus {
  SCHEDULED
  CANCELLED
  FINISHED
}

enum SeatStatus {
  AVAILABLE
  HELD
  BOOKED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(191)
  passwordHash String   @db.VarChar(255)
  fullName     String   @db.VarChar(100)
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  updatedAt    DateTime @updatedAt @db.DateTime(3)
  bookings     Booking[]
}

model Movie {
  id              Int      @id @default(autoincrement())
  title           String   @db.VarChar(255)
  synopsis        String?  @db.Text
  durationMinutes Int
  releaseDate     DateTime @db.Date
  posterUrl       String?  @db.VarChar(2048)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.DateTime(3)
  updatedAt       DateTime @updatedAt @db.DateTime(3)
  showtimes       Showtime[]

  @@index([releaseDate])
}

model Cinema {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(150)
  address   String   @db.VarChar(255)
  city      String   @db.VarChar(100)
  isActive  Boolean  @default(true)
  rooms     Room[]

  @@index([city])
}

model Room {
  id        Int     @id @default(autoincrement())
  cinemaId  Int
  name      String  @db.VarChar(100)
  isActive  Boolean @default(true)
  cinema    Cinema  @relation(fields: [cinemaId], references: [id], onDelete: Restrict)
  seats     Seat[]
  showtimes Showtime[]

  @@unique([cinemaId, name])
}

model Seat {
  id            Int      @id @default(autoincrement())
  roomId        Int
  rowLabel      String   @db.VarChar(5)
  seatNumber    Int
  type          SeatType @default(STANDARD)
  isActive      Boolean  @default(true)
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  showtimeSeats ShowtimeSeat[]

  @@unique([roomId, rowLabel, seatNumber])
}

model Showtime {
  id        Int            @id @default(autoincrement())
  movieId   Int
  roomId    Int
  startsAt  DateTime       @db.DateTime(3)
  endsAt    DateTime       @db.DateTime(3)
  status    ShowtimeStatus @default(SCHEDULED)
  movie     Movie          @relation(fields: [movieId], references: [id], onDelete: Restrict)
  room      Room           @relation(fields: [roomId], references: [id], onDelete: Restrict)
  seats     ShowtimeSeat[]
  bookings  Booking[]

  @@unique([roomId, startsAt])
  @@index([movieId, startsAt])
}

// Một dòng duy nhất cho mỗi ghế trong mỗi suất; đây là trạng thái sở hữu hiện tại.
model ShowtimeSeat {
  id               Int        @id @default(autoincrement())
  showtimeId       Int
  seatId           Int
  price            Decimal    @db.Decimal(12, 0)
  status           SeatStatus @default(AVAILABLE)
  currentBookingId Int?
  holdExpiresAt    DateTime?  @db.DateTime(3)
  showtime         Showtime   @relation(fields: [showtimeId], references: [id], onDelete: Restrict)
  seat             Seat       @relation(fields: [seatId], references: [id], onDelete: Restrict)
  currentBooking   Booking?   @relation("CurrentSeats", fields: [currentBookingId], references: [id], onDelete: Restrict)
  bookingHistory   BookingSeat[]

  @@unique([showtimeId, seatId])
  @@index([status, holdExpiresAt])
  @@index([currentBookingId])
}

model Booking {
  id           Int           @id @default(autoincrement())
  code         String        @unique @default(uuid()) @db.VarChar(36)
  userId       Int
  showtimeId   Int
  status       BookingStatus @default(PENDING)
  totalAmount  Decimal       @db.Decimal(12, 0)
  expiresAt    DateTime      @db.DateTime(3)
  confirmedAt  DateTime?     @db.DateTime(3)
  createdAt    DateTime      @default(now()) @db.DateTime(3)
  updatedAt    DateTime      @updatedAt @db.DateTime(3)
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  showtime     Showtime      @relation(fields: [showtimeId], references: [id], onDelete: Restrict)
  seats        BookingSeat[]
  currentSeats ShowtimeSeat[] @relation("CurrentSeats")

  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

// Lịch sử dòng vé vẫn còn khi đơn hết hạn/hủy và ghế được bán cho đơn mới.
model BookingSeat {
  id             Int          @id @default(autoincrement())
  bookingId      Int
  showtimeSeatId Int
  unitPrice      Decimal      @db.Decimal(12, 0)
  seatLabel      String       @db.VarChar(20)
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  showtimeSeat   ShowtimeSeat @relation(fields: [showtimeSeatId], references: [id], onDelete: Restrict)

  @@unique([bookingId, showtimeSeatId])
}
